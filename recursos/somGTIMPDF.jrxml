				<text><![CDATA[* Los montos se encuentran expresados en Pesos Mexicanos y no incluye IVA.]]></text>
				<property name="com.jaspersoft.studio.element.name" value="lblPunto1"/>
			</element>
			<element kind="staticText" uuid="9bd5d9e6-9795-4eb7-a823-4d679bd90347" x="10" y="520" width="720" height="10" fontSize="7.0" vTextAlign="Middle">
				<text><![CDATA[* La factura se presenta a 30 días de crédito.]]></text>
				<property name="com.jaspersoft.studio.element.name" value="lblPunto2"/>
			</element>
			<element kind="staticText" uuid="2fbc49f9-0f73-47ab-b30a-f9540e3073e0" x="10" y="530" width="720" height="10" fontSize="7.0" vTextAlign="Middle">
				<text><![CDATA[* El esquema del servicio es 100% remoto.]]></text>
				<property name="com.jaspersoft.studio.element.name" value="lblPunto3"/>
			</element>
			<element kind="staticText" uuid="872bb629-e1cc-440e-8048-95e96c26932a" x="10" y="540" width="720" height="10" fontSize="7.0" vTextAlign="Middle">
				<text><![CDATA[* Esta propuesta económica no incluye lincenciamiento de software ni hardware para entregar el servicio.]]></text>
				<property name="com.jaspersoft.studio.element.name" value="lblPunto4"/>
			</element>
